{
  "name": "@surakuri/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SURAKURI design tokens: single source of truth for color, spacing, type, breakpoints, motion. Tailwind v4 CSS-first via tokens.css.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
