# SURAKURI — example environment. Placeholders ONLY; never real secrets.
# Copy to `.env` (gitignored) for local development.
# Per ADR 0003 the browser holds NO Supabase key; every key below is
# server-side only (BFF routes, IMS sync). See docs/adr/0003-bff-only-data-path.md.

# Supabase project URL (server-side BFF + sync only).
SUPABASE_URL=https://your-project.supabase.co
# Service-role key: SERVER ONLY. Never prefix with PUBLIC_, never ship
# to the browser. Used by core-api BFF reads and the IMS sync adapter.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-placeholder
# Shared secret for the IMS sync webhook (api/sync-order.php).
# Must match INVENTORY_SYNC_SECRET in the IMS .env. Rotate before production.
INVENTORY_SYNC_SECRET=change-me-before-production
# Stripe placeholders (Phase 4 only; unused until payments land).
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
