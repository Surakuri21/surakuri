# core-api local dev. Copy to `.env` (gitignored, never commit).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-placeholder
# Set to 1 (with migrations 0003-0005 applied) to persist holds,
# orders, and outbox events in Supabase instead of memory.
SURAKURI_USE_SUPABASE_STORES=0
