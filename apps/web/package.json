{
  "name": "@surakuri/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SURAKURI storefront shell: Astro static pages, Tailwind v4 tokens, CSS-only motion. No client framework.",
  "main": "./src/content.ts",
  "types": "./src/content.ts",
  "exports": {
    ".": "./src/content.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "clean": "rimraf dist coverage .turbo .astro"
  },
  "dependencies": {
    "@surakuri/design-tokens": "workspace:*",
    "@surakuri/money": "workspace:*",
    "@surakuri/motion": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
