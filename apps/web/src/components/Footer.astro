---
/** Site footer: inverted surface, minimal columns, no fake fine print. */
---

<footer class="bg-coal text-paper">
  <div class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
    <div>
      <p class="font-display text-lg tracking-[0.25em] uppercase">Surakuri</p>
      <p class="pt-3 text-sm text-paper/70">
        Exceptional timepieces, documented provenance, insured delivery.
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="text-[11px] uppercase tracking-[0.2em] text-paper/60">Explore</p>
      <ul class="space-y-3 pt-3 text-sm">
        <li><a class="inline-block py-1" href="/shop">Shop</a></li>
        <li><a class="inline-block py-1" href="/collections">Collections</a></li>
        <li><a class="inline-block py-1" href="/about">About</a></li>
      </ul>
    </nav>
    <div>
      <p class="text-[11px] uppercase tracking-[0.2em] text-paper/60">Assurance</p>
      <ul class="space-y-3 pt-3 text-sm text-paper/80">
        <li>Authenticated in-house</li>
        <li>Fully insured shipping</li>
        <li>Box, papers &amp; service history</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-paper/10">
    <p class="mx-auto w-full max-w-6xl px-4 py-5 text-xs text-paper/50 sm:px-6">
      © 2026 SURAKURI. All rights reserved.
    </p>
  </div>
</footer>
